APP_NAME="Task Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://task.devline.studio
ASSET_URL=https://task.devline.studio
PUBLIC_APP_URL=https://task.devline.studio
LARAVEL_APP_URL=https://task.devline.studio
LARAVEL_API_URL=https://task.devline.studio/api

DB_CONNECTION=mysql
DB_HOST=HOSTINGER_DB_HOST
DB_PORT=3306
DB_DATABASE=HOSTINGER_DB_NAME
DB_USERNAME=HOSTINGER_DB_USERNAME
DB_PASSWORD=HOSTINGER_DB_PASSWORD

SESSION_DRIVER=file
SESSION_DOMAIN=task.devline.studio
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json

